{
  "name": "visitor-kiosk",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3010",
    "build": "next build",
    "start": "next start --port 3010",
    "lint": "eslint",
    "setup:yscp": "tsx scripts/yscp-setup.ts",
    "build:yscp-bridge": "esbuild scripts/yscp-bridge.ts --bundle --platform=node --format=cjs --outfile=tools/yscp-bridge.cjs",
    "pack": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/pack-portable.ps1",
    "pack:portable": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/pack-portable.ps1"
  },
  "dependencies": {
    "next": "16.3.4",
    "nodemailer": "^10.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "esbuild": "^0.25.0"
  }
}

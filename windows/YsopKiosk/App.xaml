<Application x:Class="YsopKiosk.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
  <!-- YSOP Kiosk 訪客系統 -->
  <Application.Resources>
    <Color x:Key="ShellStartColor">#FF13A6A9</Color>
    <Color x:Key="ShellEndColor">#FF002247</Color>
    <Color x:Key="AccentColor">#FF00BAC2</Color>
    <Color x:Key="TextPrimaryColor">#FFF7FBFF</Color>
    <Color x:Key="TextSecondaryColor">#D9F7FBFF</Color>
    <Color x:Key="TextMutedColor">#A6F7FBFF</Color>
    <Color x:Key="CardBgColor">#33FFFFFF</Color>
    <Color x:Key="CardBorderColor">#59FFFFFF</Color>
    <Color x:Key="InputBgColor">#33001828</Color>
    <Color x:Key="InputBorderColor">#80FFFFFF</Color>
    <Color x:Key="InputFocusBorderColor">#FF5BE7F1</Color>
    <Color x:Key="PrimaryBtnColor">#FF1BA9D3</Color>
    <Color x:Key="PrimaryBtnTextColor">#FFFFFFFF</Color>
    <Color x:Key="StatusBgColor">#33001828</Color>
    <Color x:Key="DividerColor">#40FFFFFF</Color>
    <Color x:Key="RowBgColor">#1AFFFFFF</Color>

    <LinearGradientBrush x:Key="ShellGradientBrush" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="{StaticResource ShellStartColor}" Offset="0"/>
      <GradientStop Color="{StaticResource ShellEndColor}" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBgColor}"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource CardBorderColor}"/>
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{StaticResource InputBgColor}"/>
    <SolidColorBrush x:Key="InputBorderBrush" Color="{StaticResource InputBorderColor}"/>
    <SolidColorBrush x:Key="InputFocusBorderBrush" Color="{StaticResource InputFocusBorderColor}"/>
    <SolidColorBrush x:Key="PrimaryBtnBrush" Color="{StaticResource PrimaryBtnColor}"/>
    <SolidColorBrush x:Key="PrimaryBtnTextBrush" Color="{StaticResource PrimaryBtnTextColor}"/>
    <SolidColorBrush x:Key="StatusBackgroundBrush" Color="{StaticResource StatusBgColor}"/>
    <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DividerColor}"/>
    <SolidColorBrush x:Key="RowBackgroundBrush" Color="{StaticResource RowBgColor}"/>

    <Style x:Key="SectionHeader" TargetType="TextBlock">
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
      <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    </Style>

    <Style x:Key="FormLabel" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
      <Setter Property="Margin" Value="0,0,0,1"/>
      <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    </Style>

    <Style x:Key="FormHint" TargetType="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Margin" Value="0,0,0,2"/>
      <Setter Property="LineHeight" Value="17"/>
      <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    </Style>

    <Style x:Key="ThemedTextBox" TargetType="TextBox">
      <Setter Property="Background" Value="{StaticResource InputBackgroundBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="8,7"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="CaretBrush" Value="{StaticResource TextPrimaryBrush}"/>
      <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}"/>
      <Style.Triggers>
        <Trigger Property="IsKeyboardFocused" Value="True">
          <Setter Property="BorderBrush" Value="{StaticResource InputFocusBorderBrush}"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="ThemedListBox" TargetType="ListBox">
      <Setter Property="Background" Value="{StaticResource InputBackgroundBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="4"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button">
      <Setter Property="Margin" Value="0,0,10,8"/>
      <Setter Property="Padding" Value="16,8"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
      <Setter Property="Background" Value="#33001828"/>
      <Setter Property="BorderBrush" Value="#80FFFFFF"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="4"
                    Padding="{TemplateBinding Padding}"
                    SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                TextOptions.TextFormattingMode="Display"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#4D001828"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#66001828"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Opacity" Value="0.55"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
      <Setter Property="Foreground" Value="{StaticResource PrimaryBtnTextBrush}"/>
      <Setter Property="Background" Value="{StaticResource PrimaryBtnBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource PrimaryBtnBrush}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="4"
                    Padding="{TemplateBinding Padding}"
                    SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                TextOptions.TextFormattingMode="Display"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#FF1596BC"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF1596BC"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#FF1285A8"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Opacity" Value="0.55"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}"/>

    <Style TargetType="Window">
      <Setter Property="Icon" Value="pack://application:,,,/kiosk.ico"/>
      <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
      <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
      <Setter Property="UseLayoutRounding" Value="True"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>
  </Application.Resources>
</Application>

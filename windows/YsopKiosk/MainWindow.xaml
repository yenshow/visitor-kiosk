<Window x:Class="YsopKiosk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:YsopKiosk"
        Title="{x:Static local:AppBrand.ProductName}"
        Width="620"
        SizeToContent="Height"
        MinWidth="560"
        WindowStartupLocation="CenterScreen"
        FontSize="14"
        ResizeMode="NoResize"
        Background="{StaticResource ShellGradientBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        Closing="OnClosing">
  <StackPanel Margin="20">
    <TextBlock FontSize="20" FontWeight="SemiBold"
               Foreground="{StaticResource TextPrimaryBrush}"
               Text="{x:Static local:AppBrand.ProductName}"/>
    <TextBlock FontSize="13" Margin="0,3,0,0"
               Foreground="{StaticResource TextPrimaryBrush}"
               Text="{x:Static local:AppBrand.RoleTitle}"/>
    <TextBlock FontSize="13" Margin="0,3,0,14"
               Foreground="{StaticResource TextMutedBrush}"
               Text="設定服務後即可啟動運行 · 關閉視窗後仍在系統匣"/>

    <Border Background="{StaticResource StatusBackgroundBrush}"
            BorderBrush="{StaticResource DividerBrush}" BorderThickness="1"
            CornerRadius="6" Padding="12,9" Margin="0,0,0,12">
      <TextBlock x:Name="TxtStatus" FontSize="13" FontWeight="SemiBold"
                 TextWrapping="Wrap" Text="偵測中…"
                 Foreground="{StaticResource TextPrimaryBrush}"/>
    </Border>

    <Border x:Name="CardService" Margin="0,0,0,12" Padding="14,12"
            Background="{StaticResource CardBackgroundBrush}"
            BorderBrush="{StaticResource CardBorderBrush}"
            BorderThickness="1" CornerRadius="10">
      <StackPanel>
        <DockPanel LastChildFill="True" Margin="0,0,0,6">
          <Border x:Name="BadgeService" Style="{StaticResource StatusBadge}" DockPanel.Dock="Right"
                  Background="{StaticResource PendingBackgroundBrush}"
                  BorderBrush="{StaticResource PendingBorderBrush}" BorderThickness="1">
            <TextBlock x:Name="TxtServiceBadge" Style="{StaticResource StatusBadgeText}"
                       Foreground="{StaticResource PendingTextBrush}" Text="預設 3010"/>
          </Border>
          <TextBlock Style="{StaticResource SectionHeader}" Margin="0"
                     VerticalAlignment="Center" Text="1. 服務設定"/>
        </DockPanel>
        <TextBlock Style="{StaticResource FormHint}"
                   Text="服務埠、管理員 IP、是否允許外部預約入站。"/>
        <Button x:Name="BtnOpenService" Content="開啟服務設定…" Margin="0,10,0,0"
                HorizontalAlignment="Left" MinWidth="180"
                Style="{StaticResource PrimaryButton}" Click="OnOpenServiceWizard"/>
      </StackPanel>
    </Border>

    <Border Padding="14,12"
            Background="{StaticResource CardBackgroundBrush}"
            BorderBrush="{StaticResource CardBorderBrush}"
            BorderThickness="1" CornerRadius="10">
      <StackPanel>
        <TextBlock Style="{StaticResource SectionHeader}" Text="2. 運行"/>
        <TextBlock Style="{StaticResource FormHint}"
                   Text="啟動訪客服務後可開啟全螢幕畫面與設定頁。"/>
        <WrapPanel Margin="0,10,0,0">
          <Button x:Name="BtnStartKiosk" Content="啟動服務" MinWidth="128"
                  Style="{StaticResource PrimaryButton}" Click="OnStartKiosk"/>
          <Button x:Name="BtnStop" Content="停止服務" MinWidth="120" Click="OnStop"/>
          <Button x:Name="BtnSetting" Content="畫面設定" MinWidth="128" Click="OnOpenSetting"/>
        </WrapPanel>
      </StackPanel>
    </Border>
  </StackPanel>
</Window>

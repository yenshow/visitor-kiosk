# =============================================================================
# 訪客服務機環境變數範本
# 複製為 .env：copy .env.example .env
# YSCP 連線／開閘請執行：npm run setup:yscp
# =============================================================================

# --- 由 npm run setup:yscp 寫入 ---
YSCP_HOST=
YSCP_AK=
YSCP_SK=
# YSCP 必須能連到此 Webhook（區網請用 http，自簽 https 常握手失敗）
# 例：http://192.168.x.x:3010/api/yscp/events
YSCP_EVENT_DEST=
YSCP_EVENT_TOKEN=Aa83124007
# YSCP_EXIT_LANES=[{"cameraIndexCode":"CAM_GUID","alarmOutputIndexCode":"RELAY_GUID"}]
YSCP_EXIT_LANES=
# 臨時外出／正式簽退後，出口 LPR 可開閘分鐘數（預設 15）
YSCP_EXIT_GATE_MINUTES=15

# --- Kiosk ---
NEXT_PUBLIC_NOTICE_VIDEO_URL=/notice.mp4
PORT=3010
ALLOWED_DEV_ORIGINS=localhost,127.0.0.1,192.168.2.8

# --- 現場預約核准通知（Microsoft 365 SMTP）---
# 租戶須允許該信箱 SMTP AUTH；機台需能連 smtp.office365.com:587
# 核准收件人於 /setting「核准通知信箱」設定（不放此處）
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# 可選；未填則用 SMTP_USER（M365 通常要求 From = 登入帳號）
MAIL_FROM=

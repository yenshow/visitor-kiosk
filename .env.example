# =============================================================================
# 訪客服務機環境變數範本
# 複製為 .env：copy .env.example .env
# =============================================================================

HCP_HOST=192.168.2.2
HCP_PORT=443
HCP_AK=
HCP_SK=
HCP_REJECT_UNAUTHORIZED=false
HCP_TIMEOUT_MS=30000
# 出場 LPR 事件開閘（HCP 必須能連到此 Webhook）
# HCP_EVENT_DEST=https://192.168.x.x:3010/api/hcp/events
HCP_EVENT_DEST=
HCP_EVENT_TOKEN=
# 出口車道：相機 indexCode → 繼電器 alarmOutputIndexCode
# HCP_EXIT_LANES=[{"cameraIndexCode":"CAM_GUID","alarmOutputIndexCode":"RELAY_GUID"}]
HCP_EXIT_LANES=
# 同車牌＋同相機開閘去重毫秒（預設 5000）
HCP_GATE_DEDUP_MS=5000
NEXT_PUBLIC_KIOSK_IDLE_SECONDS=20
# 首頁跑馬燈文字
NEXT_PUBLIC_KIOSK_MARQUEE=歡迎使用訪客服務機｜請選擇訪客報到、簽退或現場預約
# 訪客須知影片：YouTube、完整影片網址、檔案路徑或資料夾路徑
# 資料夾會自動補上 notice.mp4（例：/videos/ → /videos/notice.mp4）
NEXT_PUBLIC_NOTICE_VIDEO_URL=/notice.mp4
# 實際埠由 package.json 的 --port 3010 固定；PORT 僅作備援
PORT=3010
ALLOWED_DEV_ORIGINS=localhost,127.0.0.1,192.168.2.8
